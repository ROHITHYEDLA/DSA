class Solution {
    public int[] resultArray(int[] nums) {

        int n = nums.length;

        // Two arrays to store the elements
        int[] a = new int[n];
        int[] b = new int[n];

        int sizeA = 0;
        int sizeB = 0;

        // First element goes to a
        a[sizeA++] = nums[0];

        // Second element goes to b
        b[sizeB++] = nums[1];

        // Process remaining elements
        for (int i = 2; i < n; i++) {

            // Compare the last elements
            if (a[sizeA - 1] > b[sizeB - 1]) {
                a[sizeA++] = nums[i];
            } else {
                b[sizeB++] = nums[i];
            }
        }

        // Combine a and b
        int[] result = new int[n];

        int index = 0;

        for (int i = 0; i < sizeA; i++) {
            result[index++] = a[i];
        }

        for (int i = 0; i < sizeB; i++) {
            result[index++] = b[i];
        }

        return result;
    }
}

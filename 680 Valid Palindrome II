class Solution:
    def validPalindrome(self, s: str) -> bool:
        s1=s[::-1]
        if s==s1:
            return True
        i=0
        j=len(s)-1
        while i<j:
            if s[i]!=s[j]:
                left=s[i+1:j+1]
                right = s[i:j]
                return left==left[::-1] or right==right[::-1]
            i+=1
            j-=1
        return True
